# development no seu computador; production no servidor (aí a API recusa configuração insegura)
ENVIRONMENT=development

# Local: mongodb://localhost:27017   |   Atlas: mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=tabajara

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave
JWT_EXPIRES_MINUTES=720

# Separe várias origens por vírgula
CORS_ORIGINS=http://localhost:5173

# Endereço público do site (vai dentro dos QR Codes das mesas)
PUBLIC_SITE_URL=http://localhost:5173

# Chave do hash do CPF (Clube Tabajara). Gere outra com o mesmo comando. NUNCA troque depois de ter clientes.
# Se você já tem clientes e esta linha estava vazia, coloque aqui o MESMO valor do JWT_SECRET atual.
CPF_HASH_KEY=troque-esta-chave-tambem

# Clube: login do cliente vale só para a visita (horas); com "Manter conectado", dias
CUSTOMER_VISIT_HOURS=3
CUSTOMER_TOKEN_DAYS=30
